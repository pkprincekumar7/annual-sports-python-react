# MongoDB connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>

# JWT signing secret
JWT_SECRET=your-secret-key-change-in-production

# Email (identity-service password reset only; EMAIL_PROVIDER defaults to gmail)
# Gmail SMTP — needs 2-Step Verification + App Password on the Google account
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password
# Optional: EMAIL_FROM=your-email@gmail.com

# SendGrid SMTP
SENDGRID_API_KEY=your-sendgrid-api-key

# Resend SMTP
RESEND_API_KEY=your-resend-api-key

# Custom SMTP
SMTP_PASSWORD=your-smtp-password
